{
  "name": "react-native-boilerplate",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.13.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:debug": "eslint --debug",
    "lint:fix": "eslint --fix .",
    "ts:check": "tsc",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.101.4",
    "expo": "57.0.17",
    "expo-constants": "~57.0.15",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.1",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@tanstack/eslint-plugin-query": "5.101.4",
    "@types/react": "~19.2.4",
    "eslint": "^10.8.1",
    "eslint-config-expo": "~57.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "private": true,
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*.{js,css,md}": "prettier --write"
  }
}
